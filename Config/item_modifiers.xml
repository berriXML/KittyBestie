<configs>

	<append xpath="/item_modifiers">
	
		<item_modifier name="modKittyBestieCGM" installable_tags="head" blocked_tags="noMods,clothing" type="attachment">
			<property name="CustomIcon" value="animalKittyGuard"/>
			<property name="DescriptionKey" value="modKittyBestieCGMDesc"/>
			<property name="Stacknumber" value="1"/>
			<property name="Group" value="Mods"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="SellableToTrader" value="false"/>
				<effect_group tiered="false">

					<triggered_effect trigger="onSelfEquipUpdate" action="AttachPrefabToEntity" prefab="#@modfolder:Resources/catguard.unity3d?animalKittyGuard" parent_transform="Head" local_offset="0,0.1,0.075" local_rotation="0,0,0" local_scale=".53,.53,.53">
						<requirement name="IsAlive"/>
						<requirement name="!IsFPV"/>
					</triggered_effect>

					<triggered_effect trigger="onSelfEquipUpdate" action="RemovePrefabFromEntity" prefab="animalKittyGuard">
						<requirement name="IsAlive"/>
						<requirement name="IsFPV"/>
					</triggered_effect>

					<triggered_effect trigger="onSelfEquipStop" action="RemovePrefabFromEntity" prefab="animalKittyGuard">
						<requirement name="IsAlive"/>
					</triggered_effect>
				</effect_group>
		</item_modifier>

	</append>

</configs>
